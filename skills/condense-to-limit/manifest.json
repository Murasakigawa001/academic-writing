{
  "name": "condense-to-limit",
  "version": "1.1.0",
  "summary": "把已成型的长稿压缩到字数/词数/页数上限，并把被删内容迁入附录或补充材料。",
  "language": [
    "en",
    "zh"
  ],
  "entrypoint": "SKILL.md",
  "requires": {
    "python": ">=3.9",
    "packages": [
      "python-docx>=1.1.0"
    ],
    "optional_cli": [
      "soffice",
      "pdfinfo"
    ]
  },
  "triggers": [
    "压缩到 N 字/词/页以内",
    "超出篇幅怎么删",
    "删掉的内容放附录/附件/补充材料",
    "精简但不丢内容",
    "缩到限额同时保留全部内容"
  ],
  "not_for": [
    "从零撰写（ima-report）",
    "纯翻译或改文风",
    "单纯格式转换（ima-doc/ima-pdf）"
  ],
  "files": [
